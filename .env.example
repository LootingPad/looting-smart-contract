# RPC + verification
RPC_URL=
ETHERSCAN_API_KEY=
VERIFIER_URL=

# Deployer key. Never commit a real value (spec 29).
PRIVATE_KEY=

# Admin that holds DEFAULT_ADMIN_ROLE on every contract. Use a multisig (spec 29).
ADMIN=

# Backend keeper: registers launches and runs the LOOTING buyback.
KEEPER=

# Operations wallets receiving 50% of each flat fee.
DEVLOCK_OPS_WALLET=0x6B5A599160Eb1fFf5da90A0C63b144e341cDBF1F
STAKING_OPS_WALLET=0x2Cd6aBfFcDB83Ea1D111611696EA3a596bd997bD

# Reserved for the deferred launch router that keeps 0.00035 ETH of the launch fee.
LAUNCH_FEE_WALLET=0xD712570969461D9f736a76e290a4Ee700509a59B

# LOOTING token and the router used by buyback(). Leave empty until they exist.
LOOTING_TOKEN=
BUYBACK_ROUTER=
